# ClipBot Environment Variables
# Copy to .env and fill in your credentials

# Twitch (required for Twitch clip discovery)
CLIPBOT_TWITCH_CLIENT_ID=
CLIPBOT_TWITCH_CLIENT_SECRET=

# Kick (optional — public API works without keys for browsing)
CLIPBOT_KICK_CLIENT_ID=
CLIPBOT_KICK_CLIENT_SECRET=

# YouTube (required only if youtube.enabled=true in sources.yaml)
CLIPBOT_YOUTUBE_API_KEY=
CLIPBOT_YOUTUBE_OAUTH_CLIENT_SECRETS_FILE=

# TikTok (for publishing)
CLIPBOT_TIKTOK_CLIENT_KEY=
CLIPBOT_TIKTOK_CLIENT_SECRET=

# Instagram (for publishing)
CLIPBOT_INSTAGRAM_ACCESS_TOKEN=
